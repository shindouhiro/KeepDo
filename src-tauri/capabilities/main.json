{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口仅允许保存用户选择的文件、复制图片及打开 HTTPS 链接；登录凭据仅由 Rust 访问。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "clipboard-manager:allow-write-image",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}
