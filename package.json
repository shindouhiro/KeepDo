{
  "name": "keepdo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate:local && pnpm build:cloudflare && concurrently --kill-others --names api,web \"pnpm dev:api\" \"pnpm exec wait-on --timeout 60000 http-get://localhost:8787/api/health && pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply keepdo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply keepdo-db --remote",
    "test": "node --test tests/*.test.ts",
    "test:api": "node --test tests/api.integration.ts",
    "build": "vue-tsc -b && tsc -p tsconfig.worker.json && vite build",
    "build:cloudflare": "pnpm build --mode cloudflare",
    "preview": "vite preview",
    "deploy": "pnpm build:cloudflare && pnpm db:migrate:remote && wrangler deploy",
    "deploy:check": "pnpm build:cloudflare && wrangler deploy --dry-run",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "canvas-confetti": "^1.9.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13",
    "wait-on": "catalog:",
    "wrangler": "catalog:"
  }
}
